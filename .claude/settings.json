{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "sdlc@gil": true
  },
  "extraKnownMarketplaces": {
    "gil": {
      "source": {
        "source": "git",
        "url": "git@forge:gil/gils-clone.git"
      }
    }
  },
  "effortLevel": "xhigh",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/lurst/bin/herdr-claude record 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/lurst/bin/herdr-claude record 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
