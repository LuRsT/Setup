{
  "permissions": {
    "defaultMode": "default"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "sdlc@gil": true
  },
  "extraKnownMarketplaces": {
    "gil": {
      "source": {
        "source": "git",
        "url": "git@forge:gil/gils-clone.git"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "default",
  "theme": "auto",
  "skipAutoPermissionPrompt": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -qiE 'co-authored-by: *claude|--no-verify' && { echo 'Blocked: no Claude co-author trailers and no --no-verify' >&2; exit 2; } || exit 0"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/guard-git.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/lurst/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
